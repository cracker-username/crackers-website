# ==============================================================================
# CRACKERS ENQUIRY PLATFORM — ENVIRONMENT CONFIGURATION
# Markings:
#   [CLIENT SAFE] - Can be exposed to the browser (prefixed with NEXT_PUBLIC_)
#   [SERVER ONLY] - Confidential secrets; NEVER expose to client bundles or commit
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC URLS [CLIENT SAFE]
# ------------------------------------------------------------------------------
# Base URL of the deployed application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brand identity (editable in Admin Settings as well)
NEXT_PUBLIC_BRAND_NAME="FESTIVO FIREWORKS"

# Default support contacts for client components
NEXT_PUBLIC_DEFAULT_WHATSAPP="919172600587"
NEXT_PUBLIC_DEFAULT_PHONE="+91 91726 00587"

# Optional Cloudflare Turnstile Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ------------------------------------------------------------------------------
# 2. DATABASE & ORM [SERVER ONLY]
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Standard format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crackers_db?schema=public"

# Direct URL for migrations (if using connection pooling like Prisma Accelerate / PgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crackers_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRETS [SERVER ONLY]
# ------------------------------------------------------------------------------
# Strong 32+ character random secret for signing Jose JWT tokens
JWT_SECRET="replace-with-a-very-secure-32-char-random-jwt-secret-string"

# Secret used to HMAC-sign short-lived public URLs (success & summary verification)
URL_SIGNING_SECRET="replace-with-a-secure-random-url-signing-secret"

# Secret token required to trigger outbox background worker via /api/cron/outbox
CRON_SECRET="replace-with-a-random-cron-secret-token"

# Initial seed admin credentials (minimum password length 10 characters)
ADMIN_EMAIL="admin@festivofireworks.com"
ADMIN_PASSWORD="ChangeMeImmediately123!"
ADMIN_NAME="Primary Administrator"

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP (OPTIONAL) [SERVER ONLY]
# ------------------------------------------------------------------------------
# SMTP configuration for enquiry email notifications (Outbox worker)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="FESTIVO FIREWORKS Enquiries"
SMTP_FROM_EMAIL="enquiries@festivofireworks.com"
ADMIN_NOTIFICATION_EMAIL="owner@festivofireworks.com"

# ------------------------------------------------------------------------------
# 5. IMAGE STORAGE (STORAGE PROVIDER) [SERVER ONLY]
# ------------------------------------------------------------------------------
# Driver: "local" (development) or "cloudinary" (production)
STORAGE_DRIVER="local"

# Cloudinary credentials (required only when STORAGE_DRIVER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# ------------------------------------------------------------------------------
# 6. EXTERNAL CAPTCHA (OPTIONAL) [SERVER ONLY]
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Secret Key (if enabled)
TURNSTILE_SECRET_KEY=""
