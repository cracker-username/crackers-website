datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum StockStatus {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  UNAVAILABLE
}

enum ShippingMode {
  FREE_ABOVE_THRESHOLD
  CONFIRMED_OFFLINE
  PICKUP_ONLY
  NOT_DELIVERABLE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  AWAITING_CUSTOMER
  CONFIRMED
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

model AdminUser {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  name               String
  role               Role            @default(STAFF)
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(true)
  tokenVersion       Int             @default(1)
  failedLogins       Int             @default(0)
  lockedUntil        DateTime?       @db.Timestamptz(6)
  lastLoginAt        DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  auditLogs          AuditLog[]
  assignedEnquiries  Enquiry[]       @relation("AssignedStaff")
  enquiryNotes       EnquiryNote[]

  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  colorFrom   String    @default("#FF2E93")
  colorTo     String    @default("#FF7A18")
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  products    Product[]

  @@index([slug])
  @@index([sortOrder])
  @@index([isActive, isArchived])
}

model Product {
  id             String         @id @default(uuid())
  sku            String         @unique
  name           String
  slug           String         @unique
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  shortDesc      String?
  longDesc       String?
  brand          String?        @default("[BRAND_NAME]")
  packSize       String         // e.g. "1 Box", "5 Pcs"
  unit           String         // e.g. "Box", "Pack"
  mrpPaise       Int            // Integer paise (e.g., 50000 = Rs 500.00)
  pricePaise     Int            // Current enquiry price in paise
  availability   StockStatus    @default(IN_STOCK)
  stockQuantity  Int?           // Informational count
  lowStockAlert  Int?           @default(10)
  isFeatured     Boolean        @default(false)
  isBestseller   Boolean        @default(false)
  isNewArrival   Boolean        @default(false)
  isPremium      Boolean        @default(false)
  specifications Json?          // Array of { label: string, value: string }
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  isArchived     Boolean        @default(false)
  version        Int            @default(1) // Optimistic locking
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  images         ProductImage[]
  comboItems     ComboItem[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([availability])
  @@index([isArchived, isActive])
  @@index([sortOrder])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, sortOrder])
}

model Combo {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  description   String?
  image         String?
  originalPaise Int         // Computed aggregate value in paise
  comboPaise    Int         // Combo enquiry price in paise
  availability  StockStatus @default(IN_STOCK)
  isFeatured    Boolean     @default(false)
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  isArchived    Boolean     @default(false)
  version       Int         @default(1) // Optimistic locking
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  items         ComboItem[]

  @@index([slug])
  @@index([isActive, isArchived])
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)

  @@unique([comboId, productId])
}

model State {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. "TN", "KL"
  name          String         @unique // e.g. "Tamil Nadu"
  isUnionTerr   Boolean        @default(false)
  isActive      Boolean        @default(true)
  deliveryRules DeliveryRule[] @relation("RuleStates")

  @@index([code])
}

model DeliveryRule {
  id                         String       @id @default(uuid())
  name                       String
  isDefault                  Boolean      @default(false)
  isDeliverable              Boolean      @default(true)
  minOrderPaise              Int          @default(500000) // Default 500000 = Rs 5,000
  shippingMode               ShippingMode @default(CONFIRMED_OFFLINE)
  freeShippingThresholdPaise Int?         // e.g. 1000000 = Rs 10,000
  messageText                String
  cutoffAt                   DateTime?    @db.Timestamptz(6)
  priority                   Int          @default(0)
  isActive                   Boolean      @default(true)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(6)
  states                     State[]      @relation("RuleStates")

  @@index([isDefault, isActive])
  @@index([priority])
}

model RestrictedPincode {
  pincode   String   @id // 6 digits
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model Counter {
  id         String   @id // Formatted as "ENQUIRY_YY"
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
}

model Enquiry {
  id                 String                 @id @default(uuid())
  enquiryNumber      String                 @unique // e.g. "CE-26-000001"
  idempotencyKey     String                 @unique
  payloadHash        String
  customerName       String
  mobile             String
  whatsappNumber     String?
  email              String?
  state              String
  city               String
  pincode            String
  address            String
  preferredContact   String                 // "WHATSAPP" or "CALL"
  customerNotes      String?
  consent18Plus      Boolean                @default(true)

  // Financial snapshots at submission
  subtotalPaise      Int
  extraDiscountPaise Int                    @default(0)
  shippingPaise      Int                    @default(0)
  totalEstimatePaise Int
  minOrderPaiseSnap  Int
  ruleSnapshot       Json                   // Snapshot of delivery rule used
  originalSnapshot   Json                   // Immutable submission snapshot

  status             EnquiryStatus          @default(NEW)
  transportName      String?
  lrNumber           String?
  assignedToId       String?
  assignedTo         AdminUser?             @relation("AssignedStaff", fields: [assignedToId], references: [id])
  version            Int                    @default(1) // Optimistic locking
  isArchived         Boolean                @default(false)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)

  items              EnquiryItem[]
  statusHistory      EnquiryStatusHistory[]
  notes              EnquiryNote[]
  revisions          EnquiryRevision[]

  @@index([enquiryNumber])
  @@index([status])
  @@index([createdAt])
  @@index([mobile])
  @@index([isArchived])
}

model EnquiryItem {
  id              String   @id @default(uuid())
  enquiryId       String
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId       String?
  comboId         String?
  name            String
  sku             String
  unit            String
  packSize        String
  pricePaise      Int
  mrpPaise        Int
  discountPercent Int
  quantity        Int
  lineTotalPaise  Int
  comboContents   Json?    // Snapshot of combo contents if combo
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([enquiryId])
}

model EnquiryStatusHistory {
  id                String         @id @default(uuid())
  enquiryId         String
  enquiry           Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus        EnquiryStatus?
  toStatus          EnquiryStatus
  changedById       String?
  comment           String?
  visibleToCustomer Boolean        @default(false)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  @@index([enquiryId])
}

model EnquiryNote {
  id        String    @id @default(uuid())
  enquiryId String
  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    AdminUser @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([enquiryId])
}

model EnquiryRevision {
  id             String   @id @default(uuid())
  enquiryId      String
  enquiry        Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  revisionNumber Int
  changedById    String
  reason         String   // Mandatory reason
  beforeSnapshot Json
  afterSnapshot  Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([enquiryId, revisionNumber])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  type          String       // "NEW_ENQUIRY_ADMIN_EMAIL", "CUSTOMER_EMAIL"
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  processedAt   DateTime?    @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
}

model Setting {
  key         String   @id
  value       Json
  type        String   @default("string")
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  image     String
  linkUrl   String?
  sortOrder Int       @default(0)
  startsAt  DateTime? @db.Timestamptz(6)
  endsAt    DateTime? @db.Timestamptz(6)
  status    String    @default("PUBLISHED")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  @@index([status, sortOrder])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  location  String
  rating    Int      @default(5)
  content   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive])
}

model Page {
  slug      String   @id
  title     String
  contentMd String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model RateLimit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(6)
  count       Int      @default(1)
  expiresAt   DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model AuditLog {
  id         String     @id @default(uuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
